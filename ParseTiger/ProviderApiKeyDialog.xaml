<Window x:Class="ParseTiger.ProviderApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Key" Height="220" Width="560"
        MinHeight="220" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap"
                   Text="The key will be stored securely in Windows Credential Manager for this Windows user. It will not be written to ParseTiger files, project files, or JSON settings." />
        <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Padding="7"
                     ToolTip="Paste the API key. ParseTiger will not display it after saving." />
        <TextBlock x:Name="ValidationMessage" Grid.Row="3" Margin="0,7,0,0"
                   Foreground="DarkRed" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Save Securely" Width="120" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
