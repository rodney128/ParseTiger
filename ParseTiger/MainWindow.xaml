<Window x:Class="ParseTiger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ParseTiger" Height="800" Width="1100"
        Icon="Assets/accountant-tiger.png"
        MinHeight="700" MinWidth="800"
        Background="#E9D4BD"
        Foreground="#1C1C1C"
        Activated="Window_Activated">
    <Window.Resources>
        <SolidColorBrush x:Key="TigerOrange" Color="#F28C28" />
        <SolidColorBrush x:Key="TigerDeepOrange" Color="#C65D00" />
        <SolidColorBrush x:Key="TigerCharcoal" Color="#1C1C1C" />
        <SolidColorBrush x:Key="TigerCream" Color="#F1DDC5" />
        <SolidColorBrush x:Key="TigerSoftOrange" Color="#E8C49E" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TigerCharcoal}" />
            <Setter Property="Background" Value="{StaticResource TigerCream}" />
            <Setter Property="BorderBrush" Value="{StaticResource TigerDeepOrange}" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#4A3A2C" />
                    <Setter Property="Background" Value="#E8DDD2" />
                    <Setter Property="BorderBrush" Value="#A8927D" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource TigerDeepOrange}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#8F4100" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#3F3024" />
                    <Setter Property="Background" Value="#E8C7A7" />
                    <Setter Property="BorderBrush" Value="#B78A62" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="PackageAreaRow" Height="3*" MinHeight="86" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="OutputAreaRow" Height="2*" MinHeight="70" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="5"
                    BorderBrush="{StaticResource TigerDeepOrange}" BorderThickness="1"
                    Background="{StaticResource TigerCream}" Margin="0,0,8,0"
                    ClipToBounds="True">
                <Image Source="Assets/accountant-tiger.png"
                       Stretch="UniformToFill"
                       ToolTip="ParseTiger — precise, project-aware AI changes" />
            </Border>
            <TextBlock Grid.Column="1" Text="ParseTiger" FontSize="16"
                       FontWeight="Bold" Foreground="{StaticResource TigerDeepOrange}"
                       VerticalAlignment="Center" />

        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SolutionPath" Grid.Column="0" Padding="4"
                     VerticalContentAlignment="Center"
                     TextChanged="SolutionPath_TextChanged" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Width="90"
                    Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource TigerDeepOrange}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,0,0,6"
                Background="#F5E8D8">
            <StackPanel>
                <TextBlock Text="AI Request" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="ProviderSelector" Grid.Column="1" Height="30"
                              SelectionChanged="ProviderSelector_SelectionChanged" />
                    <TextBlock x:Name="ProviderModeDescription" Grid.Column="2"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#555555" TextWrapping="Wrap" />
                    <Button x:Name="ProviderSettingsButton" Grid.Column="3"
                            Content="AI Provider Settings..."
                            Margin="12,0,0,0" Padding="12,4"
                            ToolTip="Add, change, or remove securely stored Gemini and OpenAI API keys."
                            Click="OpenProviderSettings_Click" />
                </Grid>

                <StackPanel x:Name="DirectGenerationPanel" Margin="0,10,0,0">
                    <TextBlock Text="Requested Change" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Describe one focused change. ParseTiger will inspect the project, validate the response, apply it, build, and run."
                               Foreground="#5F6B76" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,5" />
                    <TextBox x:Name="DirectRequestBox" Height="56" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="6" TextChanged="DirectRequestBox_TextChanged"
                             ToolTip="Describe the change ParseTiger should send with the focused project context." />
                </StackPanel>

                <Border x:Name="ManualModeGuidance" Margin="0,8,0,0"
                        BorderBrush="{StaticResource TigerDeepOrange}"
                        BorderThickness="1" CornerRadius="3"
                        Padding="9,6" Background="#FFF4EC">
                    <StackPanel>
                        <TextBlock Text="Manual Mode" FontWeight="Bold"
                                   Foreground="{StaticResource TigerDeepOrange}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="#333333"
                                   Text="1. Describe your change.  2. Copy the AI request.  3. Send it to ChatGPT.  4. Paste the returned package.  5. Validate Package &amp; Run." />
                    </StackPanel>
                </Border>

                <Grid x:Name="ManualCopyPanel" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyAiRequestButton" Grid.Column="0"
                            Content="Copy AI Request"
                            MinWidth="170" Height="34" IsEnabled="False"
                            ToolTip="Copies one ordered part at a time. Paste it into the same AI chat and wait for its acknowledgement before copying the next part."
                            Click="CopyAiRequest_Click" />
                    <TextBlock Grid.Column="1"
                               Text="Paste each numbered part into the same AI chat; wait for its acknowledgement before copying the next part."
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="#666666" TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Name="ProviderConfigurationStatus" Margin="0,6,0,0"
                           Foreground="#555555" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="{StaticResource TigerOrange}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      ToolTip="Drag to resize the AI request and returned package areas" />

        <Grid Grid.Row="4" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Returned ParseTiger Package"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="ClearTextButton" Grid.Column="1"
                        Content="Clear Text" Padding="12,3"
                        ToolTip="Clear the returned package text"
                        Click="ClearReturnedPackage_Click" />
            </Grid>
            <Grid Grid.Row="1">
                <TextBox x:Name="ReturnedPackageBox"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         Padding="6"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         LostKeyboardFocus="ReturnedPackageBox_LostKeyboardFocus"
                         TextChanged="ReturnedPackageBox_TextChanged" />
                <TextBlock x:Name="ReturnedPackagePlaceholder" Text="Paste the ParseTiger JSON package returned by your AI"
                           Foreground="#777777" Margin="7,5,0,0" VerticalAlignment="Top"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,6,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Validate Package &amp; Run"
                        MinWidth="190" Height="38" Padding="16,0" FontWeight="Bold"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Validate the pasted JSON, apply it, build the solution, and launch the application"
                        Click="Run_Click" />
                <Button x:Name="RetryButton" Content="Retry Failed Run"
                        MinWidth="190" Height="38" Padding="14,0" Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        ToolTip="Ask the selected provider to repair the last failed run using its package, diagnostics, compiler output, and current affected files"
                        Click="Retry_Click" />
                <Button x:Name="UndoButton" Content="Undo" Width="80" Height="34"
                        Margin="8,2,0,0" IsEnabled="False"
                        ToolTip="Restore the files to how they were before the last successful Run Package"
                        Click="Undo_Click" />
            </StackPanel>
            <TextBlock x:Name="RetryAvailabilityText" Grid.Row="1"
                       Text="Retry unavailable: no failed run context."
                       Margin="198,5,0,0" Foreground="#6B7280"
                       FontSize="12" TextWrapping="Wrap" />
        </Grid>

        <Expander Grid.Row="6" Header="Project Reset" FontWeight="SemiBold"
                  IsExpanded="False" Margin="0,0,0,4"
                  BorderBrush="{StaticResource TigerDeepOrange}" BorderThickness="1"
                  Background="#F5E8D8" Padding="10,7">
            <ScrollViewer MaxHeight="190"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Session Baseline is automatic; Project Baseline is your durable checkpoint."
                           FontWeight="Normal" Foreground="#666666" Margin="0,2,0,8"
                           TextWrapping="Wrap" />
                <Border Background="{StaticResource TigerCream}" Padding="8" Margin="0,0,0,8"
                        CornerRadius="3">
                    <StackPanel>
                        <TextBlock x:Name="SessionBaselineStatus"
                                   Text="Session Baseline: select a solution"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="CurrentStateStatus"
                                   Text="Current State: not loaded"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="ProjectBaselineStatus"
                                   Text="Project Baseline: not checked"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="UndoRecoveryStatus"
                                   Text="Undo recovery: unavailable — no saved snapshot"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="GitRecoveryStatus"
                                   Text="Git recovery: not checked"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <WrapPanel>
                    <Button x:Name="SetBaselineButton"
                            Content="Set Current as Project Baseline"
                            Padding="12,5" Margin="0,0,8,4"
                            ToolTip="Save Current State as the durable Project Baseline used by Reset to Project Baseline."
                            Click="SetBaseline_Click" />
                    <Button x:Name="ResetBaselineButton"
                            Content="Reset to Project Baseline"
                            Padding="12,5" Margin="0,0,8,4"
                            ToolTip="Restore the durable Project Baseline. The automatic Session Baseline is never overwritten."
                            Click="ResetBaseline_Click" />
                    <Button x:Name="ResetVisualStudioDefaultButton"
                            Content="Reset to Visual Studio Default"
                            Padding="12,5" Margin="0,0,0,4"
                            ToolTip="Restore the project to the original Visual Studio template for this project type. This removes user-added code and returns the project to a clean template state."
                            Click="ResetVisualStudioDefault_Click" />
                </WrapPanel>
            </StackPanel>
            </ScrollViewer>
        </Expander>

        <Grid Grid.Row="7" Height="5" Background="{StaticResource TigerOrange}"
              ToolTip="Drag to resize the package and output areas">
            <GridSplitter HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource TigerOrange}"
                          IsHitTestVisible="False" />
            <primitives:Thumb Cursor="SizeNS"
                              Background="Transparent"
                              DragDelta="WorkspaceSplitter_DragDelta" />
        </Grid>

        <Grid Grid.Row="9" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,4,0" Padding="10,6"
                BorderBrush="{StaticResource TigerDeepOrange}" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource TigerCream}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Current workflow stage" FontWeight="SemiBold"
                           Foreground="{StaticResource TigerCharcoal}" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="16"
                           FontWeight="Bold" Foreground="{StaticResource TigerDeepOrange}"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="StatusDetailText"
                           Text="Select a solution and choose how to generate the package."
                           Foreground="#444444" TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="PipelineStatusText"
                           Text="Load → Inspect → Context → Validate → Checkpoint → Apply → Build → Run"
                           Foreground="#5B6B7A" TextWrapping="Wrap"
                           FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                <TextBlock Text="Activity" FontWeight="SemiBold"
                           Foreground="{StaticResource TigerCharcoal}" FontSize="12"
                           Margin="0,0,0,3" />
                <TextBox x:Name="WorkflowActivityStream"
                         Height="44" MinHeight="40" MaxHeight="72" IsReadOnly="True"
                         Background="White" Foreground="{StaticResource TigerCharcoal}"
                         BorderBrush="{StaticResource TigerOrange}" BorderThickness="1"
                         Padding="6,4" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         ToolTip="Live stage history for the current run" />
                <ProgressBar x:Name="Busy" Height="4" Margin="0,5,0,0"
                             Foreground="{StaticResource TigerOrange}"
                             IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="4,0,0,0" Padding="10,6"
                BorderBrush="{StaticResource TigerDeepOrange}" BorderThickness="1" CornerRadius="4"
                Background="#EFD2AE">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="Run Summary" FontWeight="SemiBold"
                               Foreground="{StaticResource TigerDeepOrange}" Margin="0,0,0,4" />
                    <TextBlock x:Name="RunSummaryText"
                               Text="No Generate &amp; Run attempt has completed yet."
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Project Changes" FontWeight="SemiBold"
                               Foreground="{StaticResource TigerDeepOrange}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ProjectChangesText"
                               Text="No project files have been modified."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <TabControl x:Name="WorkflowTabs" Grid.Row="8" Margin="0,4,0,0">
            <TabItem Header="Output">
                <TextBox x:Name="BuildOutput" IsReadOnly="True"
                         Background="#1E1E1E" Foreground="#DDDDDD"
                         FontFamily="Consolas" FontSize="12" Padding="6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics &amp; Operations">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run history"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="RunHistorySelector" Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="RunHistorySelector_SelectionChanged" />
                        <Button Grid.Column="2" Content="Copy Diagnostics"
                                Margin="8,0,0,0" Padding="12,3"
                                ToolTip="Copy a redacted diagnostic report suitable for an AI reviewer"
                                Click="CopyDiagnostics_Click" />
                        <Button Grid.Column="3" Content="Clear Diagnostics"
                                Margin="8,0,0,0" Padding="12,3"
                                ToolTip="Clear this session's run diagnostics"
                                Click="ClearDiagnostics_Click" />
                    </Grid>
                    <TextBox x:Name="DiagnosticsOutput" Grid.Row="1"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Padding="6" Background="#F7F7F7"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </TabItem>
            <TabItem Header="Plan &amp; Context">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Intent Summary"
                                  Margin="0,0,6,8">
                            <TextBox x:Name="IntentSummaryText" IsReadOnly="True"
                                     MinHeight="125" Padding="7" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </GroupBox>
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Project Health"
                                  Margin="6,0,0,8">
                            <TextBox x:Name="ProjectHealthText" IsReadOnly="True"
                                     MinHeight="125" Padding="7" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="Context Preview"
                                  Margin="0,0,6,0">
                            <TextBox x:Name="ContextPreviewText" IsReadOnly="True"
                                     MinHeight="180" Padding="7" FontFamily="Consolas"
                                     FontSize="12" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Validation Report"
                                  Margin="6,0,0,0">
                            <TextBox x:Name="ValidationReportText" IsReadOnly="True"
                                     MinHeight="180" Padding="7" FontFamily="Consolas"
                                     FontSize="12" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Memory &amp; Session Log">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Project Memory" Margin="0,0,6,0">
                        <TextBox x:Name="ProjectMemoryText" IsReadOnly="True"
                                 Padding="7" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Session Log" Margin="6,0,0,0">
                        <TextBox x:Name="SessionLogText" IsReadOnly="True"
                                 Padding="7" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Expander Grid.Row="10" Header="Advanced" IsExpanded="False">
            <StackPanel>
                <TextBlock Text="Generated Package JSON" Margin="0,6,0,4" Foreground="#666666" />
                <TextBox x:Name="JsonBox" IsReadOnly="True" Height="140" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
